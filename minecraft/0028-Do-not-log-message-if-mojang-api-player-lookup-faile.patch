Subject: [PATCH] Do not log message, if mojang api player lookup failed

---
 .../authlib/services/MinecraftServicesProfileRepository.java    | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/com/mojang/authlib/services/MinecraftServicesProfileRepository.java b/com/mojang/authlib/services/MinecraftServicesProfileRepository.java
index 65adccd1..041010cf 100644
--- a/com/mojang/authlib/services/MinecraftServicesProfileRepository.java
+++ b/com/mojang/authlib/services/MinecraftServicesProfileRepository.java
@@ -117,7 +117,7 @@ public class MinecraftServicesProfileRepository implements GameProfileRepository
             } else if (net.minecraft.server.MinecraftServer.getServer().isDebugging()) {
                 LOGGER.warn("Couldn't find profile with name: {}", name, e);
             } else {
-                LOGGER.warn("Couldn't find profile with name: {}", name);
+                // LOGGER.warn("Couldn't find profile with name: {}", name); // Brokko - no logging needed
             }
             // Paper end - only log details when debug is enabled
             return Optional.empty();
